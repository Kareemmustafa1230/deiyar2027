<?xml version="1.0" encoding="utf-8"?>
<!-- Used when hosting on IIS (e.g. MonsterASP.NET). dotnet publish fills in processPath/arguments. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <environmentVariable name="SeedDemoData" value="true" />
          <environmentVariable name="DOTNET_gcServer" value="0" />
          <environmentVariable name="DOTNET_GCConserveMemory" value="5" />
          <!-- Paste the Neon connection link (postgresql://...) between the quotes on the server. -->
          <environmentVariable name="DATABASE_URL" value="" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
